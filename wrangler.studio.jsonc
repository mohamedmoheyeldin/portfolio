{
  "$schema": "https://unpkg.com/wrangler@4.144.0/config-schema.json",
  "name": "application-studio-preview",
  "main": "workers/studio/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "vars": { "PUBLIC_AI_ENABLED": "false" },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "PUBLIC_QUOTA", "class_name": "PublicQuota" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PublicQuota"] }],
  "observability": { "enabled": true },
}
