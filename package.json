{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mohamed Moheyeldin's unified portfolio and resume platform.",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:cloudflare": "pnpm check && pnpm build",
    "build:pages": "pnpm check && node scripts/build.mjs --pages",
    "deploy:cloudflare": "pnpm build:cloudflare && pnpm dlx wrangler@4.144.0 deploy",
    "preview": "node scripts/ensure-build.mjs && vite preview",
    "check": "tsc --noEmit && node scripts/validate-content.mjs",
    "test": "pnpm check && pnpm build",
    "test:pages": "pnpm build:pages && node scripts/check-pages-build.mjs",
    "quality": "pnpm test && pnpm test:pages",
    "verify": "pnpm quality",
    "resume:generate": "python scripts/generate-resumes.py src/content/career.json public/resume"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
