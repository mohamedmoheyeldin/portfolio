{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "playwright-report", "test-results", "cypress/screenshots", "cypress/videos"],
  "compilerOptions": {
