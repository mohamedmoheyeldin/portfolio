---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCareerProfile } from '@/lib/career';

const profile = await getCareerProfile();
const education = profile.education[0];
if (!education) throw new Error('Education content is required.');
---

<BaseLayout title={`About — ${profile.name}`} description="How Mohamed Moheyeldin approaches automation, quality engineering, and technical leadership.">
  <SiteHeader name={profile.name} />
  <main id="main-content">
    <section class="page-hero page-hero--about shell">
      <p class="eyebrow">About Mohamed</p>
      <h1>Quality engineering should make delivery <span class="gradient-text">clearer, not slower.</span></h1>
      <p>{profile.summary}</p>
    </section>

    <section class="section shell" aria-labelledby="principles-title">
      <div class="section-heading">
        <p class="eyebrow">Working principles</p>
        <h2 id="principles-title">How I think about <span class="gradient-text">the work.</span></h2>
      </div>
      <div class="principle-grid">
        <article data-props-for="pointer-local visibility"><span>01</span><h3>Trust before volume.</h3><p>A smaller set of reliable, explainable tests creates more value than a large suite nobody trusts.</p></article>
        <article data-props-for="pointer-local visibility"><span>02</span><h3>Risk shapes coverage.</h3><p>Testing depth should follow product risk, user impact, and the cost of a failure—not a generic checklist.</p></article>
        <article data-props-for="pointer-local visibility"><span>03</span><h3>Diagnostics are a feature.</h3><p>Automation should shorten investigation with useful traces, artifacts, and failure messages.</p></article>
        <article data-props-for="pointer-local visibility"><span>04</span><h3>Quality is shared.</h3><p>The strongest systems bring developers, product, DevOps, and quality engineers into one delivery conversation.</p></article>
      </div>
    </section>

    <section class="section section--dark" aria-labelledby="toolkit-title">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Technical toolkit</p>
          <h2 id="toolkit-title">Deep where it matters. <span class="gradient-text">Flexible everywhere else.</span></h2>
        </div>
        <div class="skill-grid">
          {profile.skillGroups.map((group) => (
            <article data-props-for="pointer-local visibility">
              <h3>{group.label}</h3>
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section shell education-block" aria-labelledby="education-title">
      <div>
        <p class="eyebrow">Education</p>
        <h2 id="education-title">A computer science <span class="gradient-text">foundation.</span></h2>
      </div>
      <div>
        <h3>{education.credential} in {education.field}</h3>
        <p>{education.institution}<br />Virginia, United States · 2014</p>
      </div>
    </section>
  </main>
  <SiteFooter name={profile.name} />
</BaseLayout>
