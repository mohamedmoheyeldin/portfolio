---
import ExperienceList from '@/components/ExperienceList.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCareerProfile } from '@/lib/career';
import '@/styles/resume.css';

const profile = await getCareerProfile();
const root = `${import.meta.env.BASE_URL.replace(/\/?$/, '')}/`;
const downloads = {
  onePage: {
    pdf: `${root}resume/mohamed-moheyeldin-resume-one-page.pdf`,
    word: `${root}resume/mohamed-moheyeldin-resume-one-page.docx`,
  },
  detailed: {
    pdf: `${root}resume/mohamed-moheyeldin-resume-detailed.pdf`,
    word: `${root}resume/mohamed-moheyeldin-resume-detailed.docx`,
  },
};
---

<BaseLayout title={`Resume — ${profile.name}`} description="One-page and detailed resumes for a senior SDET and quality engineering leader.">
  <SiteHeader name={profile.name} />
  <main id="main-content">
    <section class="page-hero resume-hero shell" aria-labelledby="resume-title">
      <p class="eyebrow">Resume library</p>
      <h1 id="resume-title">Two resumes. One <span class="gradient-text">consistent career story.</span></h1>
      <p>Choose a concise one-page overview or a detailed technical record. Both use the same factual source as this portfolio and share its typography, spacing, and color system.</p>
    </section>

    <section class="resume-choices shell" aria-label="Resume downloads">
      <article class="resume-choice">
        <div>
          <p class="eyebrow">Fast introduction</p>
          <h2>One-page <span class="gradient-text">resume.</span></h2>
          <p>A focused overview for applications, recruiters, and first conversations.</p>
        </div>
        <ul>
          <li>Professional summary and strongest capabilities</li>
          <li>Condensed experience across all three roles</li>
          <li>Core automation, CI/CD, cloud, and AI toolkit</li>
        </ul>
        <div class="resume-downloads">
          <a class="button" href={downloads.onePage.pdf} download>Download PDF</a>
          <a class="text-link" href={downloads.onePage.word} download>Download Word <span aria-hidden="true">↓</span></a>
        </div>
      </article>
      <article class="resume-choice">
        <div>
          <p class="eyebrow">Full technical record</p>
          <h2>Detailed <span class="gradient-text">resume.</span></h2>
          <p>A deeper account for technical leadership, consulting, and federal opportunities.</p>
        </div>
        <ul>
          <li>Expanded responsibilities, delivery context, and tooling</li>
          <li>Complete skill groups across engineering and quality</li>
          <li>AI-assisted, local-first, cloud, and CI/CD practices</li>
        </ul>
        <div class="resume-downloads">
          <a class="button" href={downloads.detailed.pdf} download>Download PDF</a>
          <a class="text-link" href={downloads.detailed.word} download>Download Word <span aria-hidden="true">↓</span></a>
        </div>
      </article>
    </section>

    <section class="section shell" aria-labelledby="profile-title">
      <div class="section-heading">
        <p class="eyebrow">Profile</p>
        <h2 id="profile-title">Engineering depth with <span class="gradient-text">delivery perspective.</span></h2>
      </div>
      <div class="resume-profile-grid">
        {profile.detailedSummary.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="section shell" aria-labelledby="expertise-title">
      <div class="section-heading">
        <p class="eyebrow">Core expertise</p>
        <h2 id="expertise-title">A broader quality <span class="gradient-text">engineering toolkit.</span></h2>
        <p>Automation is the foundation, supported by delivery systems, cloud infrastructure, data validation, observability, performance testing, and practical AI engineering.</p>
      </div>
      <div class="resume-skill-grid">
        {profile.skillGroups.map((group) => (
          <article>
            <h3>{group.label}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section shell" aria-labelledby="ai-title">
      <div class="section-heading">
        <p class="eyebrow">Local and cloud AI</p>
        <h2 id="ai-title">AI workflows built around <span class="gradient-text">evidence and control.</span></h2>
        <p>{profile.aiPractice.summary}</p>
      </div>
      <div class="ai-practice">
        <h3>{profile.aiPractice.title}</h3>
        <ul class="feature-list">{profile.aiPractice.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
      </div>
    </section>

    <section class="section shell" aria-labelledby="experience-title">
      <div class="section-heading">
        <p class="eyebrow">Experience</p>
        <h2 id="experience-title">More than roles: <span class="gradient-text">systems, signals, and leadership.</span></h2>
      </div>
      <ExperienceList experience={profile.experience} />
    </section>

    <section class="section shell resume-foundation" aria-labelledby="foundation-title">
      <div>
        <p class="eyebrow">Foundation</p>
        <h2 id="foundation-title">Education and <span class="gradient-text">professional development.</span></h2>
      </div>
      <div>
        {profile.education.map((item) => <p><strong>{item.credential} in {item.field}</strong><br />{item.institution} · 2014</p>)}
        <ul>{profile.credentials.map((credential) => <li>{credential}</li>)}</ul>
      </div>
    </section>
  </main>
  <SiteFooter name={profile.name} />
</BaseLayout>
