---
import ExperienceList from '@/components/ExperienceList.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCareerProfile } from '@/lib/career';

const profile = await getCareerProfile();
const project = profile.projects[0];
if (!project) throw new Error('A featured project is required.');
---

<BaseLayout title={`Work — ${profile.name}`} description="Selected quality engineering experience, automation leadership, and delivery systems.">
  <SiteHeader name={profile.name} />
  <main id="main-content">
    <section class="page-hero shell">
      <p class="eyebrow">Experience & impact</p>
      <h1>Systems that make<br /><span class="gradient-text">confidence repeatable.</span></h1>
      <p>{profile.summary}</p>
    </section>

    <section class="section shell" aria-labelledby="career-title">
      <div class="section-heading">
        <p class="eyebrow">Career record</p>
        <h2 id="career-title">A decade of <span class="gradient-text">quality engineering.</span></h2>
      </div>
      <ExperienceList experience={profile.experience} />
    </section>

    <section class="section section--tint" aria-labelledby="project-title">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Featured build</p>
          <h2 id="project-title">Portfolio & career <span class="gradient-text">content system.</span></h2>
          <p>{project.description}</p>
        </div>
        <div class="project-detail-grid">
          <div class="project-panel project-panel--visual">
            <div class="document-stack" aria-hidden="true">
              <i class="document document--web">Web</i>
              <i class="document document--pdf">PDF</i>
              <i class="document document--word">Word</i>
            </div>
          </div>
          <div class="project-panel">
            <p class="eyebrow">What it proves</p>
            <ul class="feature-list feature-list--large">
              {project.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
            <ul class="chip-list">
              {project.technologies.map((technology) => <li>{technology}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter name={profile.name} />
</BaseLayout>
