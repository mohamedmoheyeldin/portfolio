---
import ExperienceList from '@/components/ExperienceList.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCareerProfile } from '@/lib/career';

const profile = await getCareerProfile();
const root = `${import.meta.env.BASE_URL.replace(/\/?$/, '')}/`;
---

<BaseLayout title={`Work — ${profile.name}`} description="Selected quality engineering experience, automation leadership, and delivery systems.">
  <SiteHeader name={profile.name} />
  <main id="main-content">
    <section class="page-hero shell">
      <p class="eyebrow">Experience & impact</p>
      <h1>Systems that make<br /><span class="gradient-text">confidence repeatable.</span></h1>
      <p>{profile.summary}</p>
    </section>

    <section class="section shell" aria-labelledby="projects-title">
      <div class="section-heading">
        <p class="eyebrow">Selected case studies</p>
        <h2 id="projects-title">Real delivery problems. <span class="gradient-text">Traceable engineering decisions.</span></h2>
        <p>These case studies use documented responsibilities and delivery context from my career record. Client-sensitive details stay generalized; the engineering work stays concrete.</p>
      </div>
      <div class="project-card-grid project-card-grid--work">
        {profile.projects.map((project, index) => (
          <article class:list={["project-card", { "project-card--featured": index === 0 }]} data-props-for="pointer-local visibility">
            <div class="project-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <p class="eyebrow">{project.context} · {project.period}</p>
              <h3><a href={`${root}work/${project.slug}/`}>{project.name}</a></h3>
              <p>{project.description}</p>
            </div>
            <ul class="chip-list">{project.technologies.slice(0, 5).map((technology) => <li>{technology}</li>)}</ul>
            <a class="text-link" href={`${root}work/${project.slug}/`}>Read case study <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="section section--tint" aria-labelledby="career-title">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Career record</p>
          <h2 id="career-title">A decade of <span class="gradient-text">quality engineering.</span></h2>
          <p>The roles behind the case studies, with official titles, professional scope, and source-grounded responsibilities.</p>
        </div>
        <ExperienceList experience={profile.experience} />
      </div>
    </section>
  </main>
  <SiteFooter name={profile.name} />
</BaseLayout>
