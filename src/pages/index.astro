---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCareerProfile } from '@/lib/career';

const profile = await getCareerProfile();
const featuredProjects = profile.projects.slice(0, 3);
if (featuredProjects.length < 3) throw new Error('Three featured projects are required.');
const root = `${import.meta.env.BASE_URL.replace(/\/?$/, '')}/`;
const title = `${profile.name} — ${profile.headline}`;
const description = 'Senior SDET and Test Automation Lead designing scalable UI and API automation, CI/CD quality signals, and dependable release systems.';
---

<BaseLayout title={title} description={description}>
  <SiteHeader name={profile.name} />
  <main id="main-content">
    <section class="page-hero page-hero--home shell" aria-labelledby="intro-title">
      <div class="hero-copy" data-props-for="visibility">
        <p class="eyebrow">Senior SDET · Quality Engineering</p>
        <h1 id="intro-title">Engineering confidence into <span class="gradient-text">every release.</span></h1>
        <p>I design the automation, delivery signals, and quality systems that help teams move fast without losing trust.</p>
        <p class="hero-meta">Reston, Virginia · Senior SDET · Test Automation Lead</p>
        <div class="button-row">
          <a class="button" href={`${root}work/`}>Explore my work</a>
          <a class="text-link" href={`${root}resume/`}>View resume <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="quality-signal" data-props-for="pointer-local visibility" aria-hidden="true">
        <div class="quality-signal__bar"><span><i></i> Quality signal model</span><b>ACTIVE</b></div>
        <div class="quality-signal__field">
          <span class="signal-orbit signal-orbit--one"></span>
          <span class="signal-orbit signal-orbit--two"></span>
          <span class="signal-beam"></span>
          <div class="signal-core"><small>RELEASE</small><strong>READY</strong><span>confidence signal</span></div>
          <i class="signal-node signal-node--ui">UI</i>
          <i class="signal-node signal-node--api">API</i>
          <i class="signal-node signal-node--ci">CI</i>
          <i class="signal-node signal-node--obs">OBS</i>
        </div>
        <div class="quality-signal__footer"><span><i></i> UI + API checks</span><span><i></i> Release gates</span><span>Actionable feedback</span></div>
      </div>
    </section>

    <section class="proof-strip" aria-label="Career highlights">
      <div class="shell proof-grid">
        <div data-props-for="visibility"><strong>10+</strong><span>years engineering quality</span></div>
        <div data-props-for="visibility"><strong>5</strong><span>automation engineers led</span></div>
        <div data-props-for="visibility"><strong>UI + API</strong><span>one quality strategy</span></div>
      </div>
    </section>

    <section class="section shell" aria-labelledby="systems-title">
      <div class="section-heading">
        <p class="eyebrow">What I build</p>
        <h2 id="systems-title">Quality systems that make <span class="gradient-text">delivery feel clear.</span></h2>
        <p>From the first testable requirement to the final release signal, I connect engineering decisions into a system teams can understand and trust.</p>
      </div>
      <div class="bento-grid">
        <article class="feature-card feature-card--wide" data-props-for="pointer-local visibility">
          <div>
            <p class="eyebrow">Automation architecture</p>
            <h3>Frameworks designed <span class="gradient-text">for change.</span></h3>
            <p>Maintainable UI and API automation with resilient assertions, purposeful abstractions, useful diagnostics, and fast feedback.</p>
          </div>
          <img class="framework-visual" src={`${root}images/quality-engineering-system.webp`} width="1680" height="945" loading="lazy" decoding="async" alt="Illustration of code flowing through browser and API tests, parallel CI workers, diagnostics, and a release signal" />
        </article>
        <article class="feature-card feature-card--blue" data-props-for="pointer-local visibility">
          <p class="eyebrow">Delivery signals</p>
          <h3>Quality gates, not roadblocks.</h3>
          <p>CI/CD checks that surface the right risk at the right moment.</p>
          <div class="mini-chart" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </article>
        <article class="feature-card" data-props-for="pointer-local visibility">
          <p class="eyebrow">Technical leadership</p>
          <h3>Standards teams can actually use.</h3>
          <p>Practical strategy, mentoring, code review, and shared ownership that turns quality into an engineering capability.</p>
          <div class="avatar-stack" aria-hidden="true"><i>MM</i><i>QA</i><i>DEV</i><i>+5</i></div>
        </article>
      </div>
    </section>

    <section class="section section--tint" aria-labelledby="work-title">
      <div class="shell">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Selected work</p>
            <h2 id="work-title">Built for evidence, <span class="gradient-text">not theater.</span></h2>
          </div>
          <a class="text-link" href={`${root}work/`}>See all case studies <span aria-hidden="true">→</span></a>
        </div>
        <div class="project-card-grid">
          {featuredProjects.map((project, index) => (
            <article class:list={["project-card", { "project-card--featured": index === 0 }]} data-props-for="pointer-local visibility">
              <div class="project-card__number" aria-hidden="true">0{index + 1}</div>
              <div>
                <p class="eyebrow">{project.context} · {project.period}</p>
                <h3><a href={`${root}work/${project.slug}/`}>{project.name}</a></h3>
                <p>{project.description}</p>
              </div>
              <ul class="chip-list">
                {project.technologies.slice(0, 4).map((technology) => <li>{technology}</li>)}
              </ul>
              <a class="text-link" href={`${root}work/${project.slug}/`}>Read case study <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section shell" aria-labelledby="cta-title" data-props-for="visibility">
      <p class="eyebrow">Let’s build confidence</p>
      <h2 id="cta-title">Ready for a better <span class="gradient-text">release signal?</span></h2>
      <p>Let’s talk about automation strategy, quality architecture, or the next system your team needs to trust.</p>
      <a class="button" href="mailto:mohamedmoheyeldin.jobs@gmail.com?subject=Quality%20engineering%20conversation">Email Mohamed</a>
    </section>
  </main>
  <SiteFooter name={profile.name} />
</BaseLayout>
