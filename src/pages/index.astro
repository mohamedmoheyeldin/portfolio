---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCareerProfile } from '@/lib/career';

const profile = await getCareerProfile();
const project = profile.projects[0];
if (!project) throw new Error('A featured project is required.');
const root = `${import.meta.env.BASE_URL.replace(/\/?$/, '')}/`;
const description = `${profile.name} — ${profile.headline}`;
---

<BaseLayout title={description} description={profile.summary}>
  <SiteHeader name={profile.name} />
  <main id="main-content">
    <section class="page-hero page-hero--home shell" aria-labelledby="intro-title">
      <p class="eyebrow">Senior SDET · Quality Engineering</p>
      <h1 id="intro-title">Engineering confidence into <span class="gradient-text">every release.</span></h1>
      <p>I design the automation, delivery signals, and quality systems that help teams move fast without losing trust.</p>
      <div class="button-row">
        <a class="button" href={`${root}work/`}>Explore my work</a>
        <a class="text-link" href={`${root}resume/`}>View resume <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="proof-strip" aria-label="Career highlights">
      <div class="shell proof-grid">
        <div><strong>10+</strong><span>years engineering quality</span></div>
        <div><strong>5</strong><span>automation engineers led</span></div>
        <div><strong>UI + API</strong><span>one quality strategy</span></div>
        <div><strong>Web · PDF · Word</strong><span>one source of truth</span></div>
      </div>
    </section>

    <section class="section shell" aria-labelledby="systems-title">
      <div class="section-heading">
        <p class="eyebrow">What I build</p>
        <h2 id="systems-title">Quality systems that make delivery feel clear.</h2>
        <p>From the first testable requirement to the final release signal, I connect engineering decisions into a system teams can understand and trust.</p>
      </div>
      <div class="bento-grid">
        <article class="feature-card feature-card--wide feature-card--dark">
          <div>
            <p class="eyebrow">Automation architecture</p>
            <h3>Frameworks designed for change.</h3>
            <p>Maintainable UI and API automation with resilient assertions, purposeful abstractions, useful diagnostics, and fast feedback.</p>
          </div>
          <div class="code-window" aria-hidden="true">
            <span><i class="dot dot--red"></i><i class="dot dot--amber"></i><i class="dot dot--green"></i></span>
            <code><em>test</em>(<b>'release confidence'</b>, async context =&gt; {'{'}</code>
            <code>&nbsp;&nbsp;await signals.verify();</code>
            <code>&nbsp;&nbsp;expect(risk).toBeVisible();</code>
            <code>{'}'});</code>
          </div>
        </article>
        <article class="feature-card feature-card--blue">
          <p class="eyebrow">Delivery signals</p>
          <h3>Quality gates, not roadblocks.</h3>
          <p>CI/CD checks that surface the right risk at the right moment.</p>
          <div class="mini-chart" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </article>
        <article class="feature-card">
          <p class="eyebrow">Technical leadership</p>
          <h3>Standards teams can actually use.</h3>
          <p>Practical strategy, mentoring, code review, and shared ownership that turns quality into an engineering capability.</p>
          <div class="avatar-stack" aria-hidden="true"><i>MM</i><i>QA</i><i>DEV</i><i>+5</i></div>
        </article>
      </div>
    </section>

    <section class="section section--tint" aria-labelledby="work-title">
      <div class="shell">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Selected work</p>
            <h2 id="work-title">Built for evidence, not theater.</h2>
          </div>
          <a class="text-link" href={`${root}work/`}>See all experience <span aria-hidden="true">→</span></a>
        </div>
        <article class="case-study-card">
          <div class="case-study-card__copy">
            <p class="eyebrow">Original platform · 2026</p>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <ul class="chip-list">
              {project.technologies.slice(0, 5).map((technology) => <li>{technology}</li>)}
            </ul>
            <a class="text-link" href="https://github.com/mohamedmoheyeldin/portfolio">View the source <span aria-hidden="true">↗</span></a>
          </div>
          <div class="architecture-visual" aria-label="One career source serving web, PDF, and Word formats">
            <div class="source-node"><span>Verified career data</span><strong>One source</strong></div>
            <div class="connector-lines" aria-hidden="true"></div>
            <div class="output-nodes"><span>Web</span><span>PDF</span><span>Word</span></div>
          </div>
        </article>
      </div>
    </section>

    <section class="cta-section shell" aria-labelledby="cta-title">
      <p class="eyebrow">Let’s build confidence</p>
      <h2 id="cta-title">Ready for a better release signal?</h2>
      <p>Let’s talk about automation strategy, quality architecture, or the next system your team needs to trust.</p>
      <a class="button" href="mailto:mohamedmoheyeldin.jobs@gmail.com">Start a conversation</a>
    </section>
  </main>
  <SiteFooter name={profile.name} />
</BaseLayout>
