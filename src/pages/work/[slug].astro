---
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCareerProfile } from '@/lib/career';

export async function getStaticPaths() {
  const profile = await getCareerProfile();
  return profile.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const profile = await getCareerProfile();
const root = `${import.meta.env.BASE_URL.replace(/\/?$/, '')}/`;
const description = project.description;
---

<BaseLayout title={`${project.name} — ${profile.name}`} description={description} socialImage={null}>
  <SiteHeader name={profile.name} />
  <main id="main-content">
    <article>
      <header class="case-hero shell">
        <a class="back-link" href={`${root}work/`}><span aria-hidden="true">←</span> All case studies</a>
        <p class="eyebrow">{project.context} · {project.period}</p>
        <h1>{project.name}</h1>
        <p class="case-hero__lede">{project.description}</p>
        <dl class="case-facts">
          <div><dt>Role</dt><dd>{project.role}</dd></div>
          <div><dt>Context</dt><dd>{project.context}</dd></div>
          <div><dt>Period</dt><dd>{project.period}</dd></div>
        </dl>
      </header>

      <section class="case-section shell" aria-labelledby="challenge-title">
        <div class="case-section__label"><p class="eyebrow">01 · Challenge</p></div>
        <div class="case-section__content">
          <h2 id="challenge-title">The delivery problem.</h2>
          <p class="case-emphasis">{project.challenge}</p>
        </div>
      </section>

      <section class="case-section shell" aria-labelledby="approach-title">
        <div class="case-section__label"><p class="eyebrow">02 · Approach</p></div>
        <div class="case-section__content">
          <h2 id="approach-title">How I shaped the system.</h2>
          <ol class="approach-list">
            {project.approach.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>)}
          </ol>
        </div>
      </section>

      <section class="case-section shell" aria-labelledby="outcome-title">
        <div class="case-section__label"><p class="eyebrow">03 · Outcome</p></div>
        <div class="case-section__content">
          <h2 id="outcome-title">What changed.</h2>
          <p class="case-emphasis">{project.outcome}</p>
          <ul class="evidence-grid">
            {project.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </div>
      </section>

      <section class="case-toolkit shell" aria-labelledby="toolkit-title">
        <div>
          <p class="eyebrow">Technical toolkit</p>
          <h2 id="toolkit-title">Tools in context.</h2>
        </div>
        <ul class="chip-list">{project.technologies.map((technology) => <li>{technology}</li>)}</ul>
        {project.repository && <a class="text-link" href={project.repository}>View source <span aria-hidden="true">↗</span></a>}
      </section>

      <aside class="case-note shell" aria-label="Case study disclosure">
        <strong>About this case study</strong>
        <p>{project.kind === 'career' ? 'This account is derived from documented career responsibilities. Client-sensitive details are intentionally generalized, and no undisclosed metrics are presented.' : 'This independent project is public and its implementation can be reviewed in the linked source repository.'}</p>
      </aside>
    </article>

    <section class="cta-section shell" aria-labelledby="case-cta-title">
      <p class="eyebrow">Continue the conversation</p>
      <h2 id="case-cta-title">Need a stronger <span class="gradient-text">quality signal?</span></h2>
      <p>Let’s talk about automation architecture, delivery feedback, or the engineering system behind dependable releases.</p>
      <a class="button" href="mailto:mohamedmoheyeldin.jobs@gmail.com?subject=Quality%20engineering%20case%20study">Email Mohamed</a>
    </section>
  </main>
  <SiteFooter name={profile.name} />
</BaseLayout>
