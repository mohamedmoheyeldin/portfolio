---
interface Props { name: string }
const { name } = Astro.props;
const root = `${import.meta.env.BASE_URL.replace(/\/?$/, '')}/`;
const path = Astro.url.pathname;
const isActive = (segment: string) => path === `${root}${segment}/` || path.startsWith(`${root}${segment}/`);
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="wordmark" href={root} aria-label={`${name}, home`}>
      <span aria-hidden="true">MM</span>
      <span class="wordmark__name">{name}</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        <li><a href={`${root}work/`} aria-current={isActive('work') ? 'page' : undefined}>Work</a></li>
        <li><a href={`${root}about/`} aria-current={isActive('about') ? 'page' : undefined}>About</a></li>
        <li><a href={`${root}resume/`} aria-current={isActive('resume') ? 'page' : undefined}>Resume</a></li>
        <li class="mobile-contact"><a href="mailto:mohamedmoheyeldin.jobs@gmail.com">Contact</a></li>
      </ul>
    </nav>
    <a class="button button--small" href="mailto:mohamedmoheyeldin.jobs@gmail.com?subject=Portfolio%20conversation">Let’s connect</a>
  </div>
</header>
