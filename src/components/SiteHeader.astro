---
interface Props { name: string }
const { name } = Astro.props;
const root = `${import.meta.env.BASE_URL.replace(/\/?$/, '')}/`;
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="wordmark" href={root} aria-label={`${name}, home`}>
      <span aria-hidden="true">MM</span>
      <span class="wordmark__name">{name}</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul>
        <li><a href={`${root}work/`}>Work</a></li>
        <li><a href={`${root}about/`}>About</a></li>
        <li><a href={`${root}resume/`}>Resume</a></li>
      </ul>
    </nav>
    <a class="button button--small" href="mailto:mohamedmoheyeldin.jobs@gmail.com">Let’s connect</a>
  </div>
</header>
