# Local job-assistant service. Never expose these values through Astro PUBLIC_* variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
JOB_ASSISTANT_ORIGIN=http://127.0.0.1:4321
JOB_ASSISTANT_PORT=8787
JOB_ASSISTANT_DEMO=false
# Optional when python3 does not already include python-docx and reportlab.
JOB_ASSISTANT_PYTHON=python3
