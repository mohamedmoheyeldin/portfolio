{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-job-assistant-api",
  "main": "./workers/job-assistant/src/index.mjs",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mohamedmoheyeldin.com/api/assistant/*",
      "zone_name": "mohamedmoheyeldin.com"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://mohamedmoheyeldin.com",
    "API_BASE_PATH": "/api/assistant",
    "GOOGLE_REDIRECT_URI": "https://mohamedmoheyeldin.com/api/assistant/oauth/google/callback",
    "GMAIL_QUERY": "newer_than:30d (job OR recruiter OR interview OR application OR \"right to represent\" OR confirmation)",
    "AUTOMATION_BATCH_SIZE": "25",
    "AUTOMATION_MAX_ATTEMPTS": "6",
    "OPENAI_MODEL": "gpt-5.4-mini",
    "AI_GATEWAY_ID": "portfolio-job-assistant",
    "CLOUDFLARE_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    "ACCESS_TEAM_DOMAIN": "https://REPLACE_WITH_TEAM_NAME.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD",
    "OWNER_EMAIL": "REPLACE_WITH_YOUR_ACCESS_EMAIL",
    "GMAIL_ACCOUNT_EMAILS": "mohamedmoheyeldin.jobs@gmail.com",
    "AUTOMATION_MIN_CONFIDENCE": "85",
    "AUTOMATION_MODE": "AUTOMATION_OFF",
    "NEEDS_ATTENTION_LABEL": "AI-Career/Needs-Attention",
    "GMAIL_MAX_MESSAGE_BYTES": "512000",
    "AUTOMATION_SENDER_DOMAINS": ""
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "AI_GATEWAY_TOKEN",
      "TOKEN_ENCRYPTION_KEY",
      "CLOUDFLARE_BROWSER_RENDERING_TOKEN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-job-assistant",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./workers/job-assistant/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "portfolio-job-assistant-artifacts"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
